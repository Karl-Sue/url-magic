{
  "routes": [
    {
      "route": "animations/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "mimeTypes": {
    ".lottie": "application/zip"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_next/*", "/icons/*", "/images/*", "/animations/*"]
  }
}
